# AegisShare - exemplo de configuracao
# Copie para .env e troque todos os valores marcados como CHANGE_ME.

# Aplicacao
DEBUG=false
ENVIRONMENT=production
PORT=8000
APP_PORT=8000
TIME_ZONE=America/Fortaleza
SECRET_KEY=CHANGE_ME_GERE_COM_MANAGE_PY_GENERATE_SECRETS
FILE_ENCRYPTION_KEY=CHANGE_ME_GERE_COM_MANAGE_PY_GENERATE_SECRETS

# Hosts / HTTPS
ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# PostgreSQL interno (compose.yml e compose.no-redis.yml)
POSTGRES_DB=aegisshare
POSTGRES_USER=aegisshare
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Servicos externos usados pelos composes alternativos
# Obrigatorio nos composes sem PostgreSQL interno.
EXTERNAL_DATABASE_URL=
# Opcional nos composes sem Redis interno. Vazio = channel layer/cache em memoria.
# Para multiplas replicas/workers, configure um Redis externo.
EXTERNAL_REDIS_URL=

# Para executar Django fora do Docker, voce tambem pode definir diretamente:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# REDIS_URL=redis://host:6379/0

# IPFS / Pinata
PINATA_JWT_TOKEN=CHANGE_ME_PINATA_JWT
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/{cid}
PINATA_TIMEOUT_SECONDS=90

# Arquivos
FILE_MAX_UPLOAD_MB=50
FILE_RETENTION_DAYS=30

# Antimalware opcional
CLAMAV_ENABLED=false
CLAMAV_REQUIRED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Observabilidade
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Processo web
WEB_WORKERS=2
RUN_MIGRATIONS=true
COLLECT_STATIC=true
DB_STARTUP_ATTEMPTS=30
